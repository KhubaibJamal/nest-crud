PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=30&pool_timeout=30"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/reset-password

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-email-password
MAIL_FROM="My App <your-email@yourdomain.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret